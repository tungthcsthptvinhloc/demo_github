{
  "name": "quan-ly-nhiem-vu-hsg",
  "version": "2.0.0",
  "description": "Ứng dụng quản lý việc thực hiện nhiệm vụ của học sinh đội tuyển HSG (Vercel + Neon Postgres + Vercel Blob)",
  "main": "lib/app.js",
  "private": true,
  "scripts": {
    "dev": "node dev-server.js",
    "build:blob": "esbuild scripts/blob-client-entry.js --bundle --minify --format=iife --global-name=VercelBlob --platform=browser --target=es2019 \"--banner:js=var process=globalThis.process||{env:{}};\" --outfile=public/vendor/vercel-blob-client.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "esbuild": "^0.28.2"
  }
}
